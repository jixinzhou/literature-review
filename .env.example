# 复制本文件为项目根目录下的 .env 再填写（程序只读取 .env）
# 通义千问（OpenAI 兼容接口，如阿里云 DashScope）
QWEN_API_KEY=sk-bfc9c4f72a6149d99c56b5df6ede1e05
# 可选：默认 https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_INTENT_MODEL=qwen-max
QWEN_WRITING_MODEL=qwen-max

# OpenAlex：无需密钥；填写邮箱可进入 Polite Pool（可选）
OPENALEX_EMAIL=3nINjxrqO8Bd3amUUUkzgx
OPENALEX_BASE_URL=https://api.openalex.org

# 英文候选池条数；英文/中文分别排序后各取 TOP_K_EN、TOP_K_ZH（不混合排序）
FETCH_POOL_SIZE=50
TOP_K_EN=15
TOP_K_ZH=5
# 是否用 AI 按标题筛选文献（true/false），默认 true
USE_AI_SELECTION=true
